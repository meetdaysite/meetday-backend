# App
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/meetday

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Firebase
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-client-email@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Mail (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=noreply@meetday.in
MAIL_PASS=your-smtp-password
MAIL_FROM=Meetday <noreply@meetday.in>

# Razorpay
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Encryption (AES-256-GCM) — generate with: openssl rand -hex 32
ENCRYPTION_KEY=your_64_char_hex_key_here

# Frontend (used for password reset links in admin invite emails)
FRONTEND_URL=http://localhost:3000

# GCP Cloud Storage (media uploads)
GCP_PROJECT_ID=your-gcp-project-id
GCP_STORAGE_BUCKET=your-bucket-name
GCP_KEY_FILE=/path/to/service-account-key.json  # omit on GCP infra (uses ADC automatically)

# Sandbox (KYC/bank verification — test key for dev)
SANDBOX_HOST=https://test-api.sandbox.co.in
SANDBOX_API_KEY=your_sandbox_api_key
SANDBOX_API_SECRET=your_sandbox_api_secret

# Seeder — Super Admin
SUPER_ADMIN_EMAIL=superadmin@meetday.com
SUPER_ADMIN_PASSWORD=ChangeMe123!
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin

# AI Server
AI_SERVER_URL=http://localhost:8001/v1
INTERNAL_API_KEY=your_internal_api_key
